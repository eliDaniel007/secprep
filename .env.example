# Copiez ce fichier en .env et renseignez les valeurs. .env est ignore par git.

# Base de donnees (SQLite en developpement)
DATABASE_URL="file:./dev.db"

# Secret de session (iron-session) — AU MOINS 32 caracteres.
# Generez-en un : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PASSWORD=""

# Creation de comptes via `pnpm run create-user` (optionnel : mode non interactif)
# Si vides, le script demande les informations de maniere interactive.
SEED_USER_EMAIL=""
SEED_USER_NAME=""
SEED_USER_PASSWORD=""
