# Copiez ce fichier en .env et renseignez les valeurs. .env est ignore par git.

# Base de donnees (SQLite en developpement)
DATABASE_URL="file:./dev.db"

# Secret de session (iron-session) — AU MOINS 32 caracteres.
# Generez-en un : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PASSWORD=""

# Correction IA des rapports (Phase 5) — cle API Anthropic, cote serveur seulement.
# Sans cle, l'editeur fonctionne mais l'analyse IA affiche "cle manquante".
ANTHROPIC_API_KEY=""
# Modele utilise (optionnel ; defaut : claude-opus-5-5).
ANTHROPIC_MODEL=""
# Plafond d'appels IA par jour et par utilisateur (optionnel ; defaut : 20).
MAX_CORRECTIONS_JOUR=""

# Creation de comptes via `pnpm run create-user` (optionnel : mode non interactif)
# Si vides, le script demande les informations de maniere interactive.
SEED_USER_EMAIL=""
SEED_USER_NAME=""
SEED_USER_PASSWORD=""
