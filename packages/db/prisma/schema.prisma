// Schema Prisma — Phase 1 (Fondations)
// SQLite pour demarrer. Les valeurs "enum" sont stockees en String et
// contraintes par Zod (@secprep/bank), ce qui garde le schema portable
// vers PostgreSQL plus tard.
//
// Les tables des phases ulterieures (revision_espacee, session_examen, duel,
// signalement_question, rapport*, scenario_lab, enquete, capteur, ...) seront
// ajoutees a leur phase respective via des migrations incrementales.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id             String   @id @default(cuid())
  courriel       String   @unique
  nom            String
  motDePasseHash String
  role           String   @default("etudiant") // etudiant | admin
  creeLe         DateTime @default(now())

  tentatives   Tentative[]
  progressions ProgressionDomaine[]
  examens      SessionExamen[]
  revisions    RevisionEspacee[]
  duelsCrees   Duel[]
  participations DuelParticipation[]
  rapports     Rapport[]
  enquetes     Enquete[]
  sessionsSandbox SessionSandbox[]
  progressionsLabo ProgressionLabo[]

  @@map("utilisateur")
}

model Question {
  id             String   @id // = l'id du JSON, ex. "Q001"
  domaine        Int // 1..5
  coursGoogle    Int? // 1..9
  type           String // qcm | qcm_multiple | vf | libre | scenario | urgence | plan_reprise | ordonnancement | appariement | cas_complexe
  difficulte     String // facile | moyen | difficile
  tempsSec       Int
  enonce         String
  explication    String
  indice         String?
  astuce         String?
  objectifSy0701 String?
  tags           String   @default("[]") // JSON string[]
  contenu        String // JSON specifique au type (valide par Zod a l'ecriture ET a la lecture)
  source         String   @default("officiel") // officiel | lot | genere
  statut         String   @default("valide") // brouillon | valide
  creeLe         DateTime @default(now())
  misAJourLe     DateTime @updatedAt

  tentatives Tentative[]
  revisions  RevisionEspacee[]

  @@index([domaine])
  @@index([type])
  @@index([difficulte])
  @@map("question")
}

// Structure prete — remplie a partir de la Phase 2.
model Tentative {
  id            String   @id @default(cuid())
  utilisateurId String
  questionId    String
  reponseDonnee String // JSON
  correct       Boolean
  score         Int      @default(0)
  tempsPris     Int      @default(0) // secondes
  creeLe        DateTime @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
  @@index([questionId])
  @@map("tentative")
}

// Structure prete — remplie a partir de la Phase 2.
model ProgressionDomaine {
  id               String   @id @default(cuid())
  utilisateurId    String
  domaine          Int
  questionsVues    Int      @default(0)
  questionsReussies Int     @default(0)
  majLe            DateTime @updatedAt

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, domaine])
  @@map("progression_domaine")
}

// Simulateur d'examen (Phase 3).
model SessionExamen {
  id            String    @id @default(cuid())
  utilisateurId String
  debutLe       DateTime  @default(now())
  finLe         DateTime?
  dureeSec      Int       @default(0)
  total         Int       @default(0)
  corrects      Int       @default(0)
  score         Int       @default(100) // echelle 100-900
  reussi        Boolean   @default(false)
  detail        String    @default("{}") // JSON : repartition par domaine, par question

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
  @@map("session_examen")
}

// Repetition espacee SM-2 (Phase 4).
model RevisionEspacee {
  id               String   @id @default(cuid())
  utilisateurId    String
  questionId       String
  repetitions      Int      @default(0)
  intervalleJours  Int      @default(0)
  facilite         Float    @default(2.5)
  prochaineRevision DateTime @default(now())
  derniereRevision DateTime @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, questionId])
  @@index([utilisateurId, prochaineRevision])
  @@map("revision_espacee")
}

// Duel / cooperation en differe (Phase 4).
model Duel {
  id          String   @id @default(cuid())
  code        String   @unique
  createurId  String
  mode        String   @default("duel") // duel | coop
  questionIds String // JSON : liste figee d'ids (meme ordre pour les deux)
  nombre      Int
  creeLe      DateTime @default(now())

  createur      Utilisateur         @relation(fields: [createurId], references: [id], onDelete: Cascade)
  participations DuelParticipation[]

  @@map("duel")
}

model DuelParticipation {
  id            String   @id @default(cuid())
  duelId        String
  utilisateurId String
  pointsGagnes  Int      @default(0)
  pointsMax     Int      @default(0)
  corrects      Int      @default(0)
  total         Int      @default(0)
  termineLe     DateTime @default(now())

  duel        Duel        @relation(fields: [duelId], references: [id], onDelete: Cascade)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([duelId, utilisateurId])
  @@index([duelId])
  @@map("duel_participation")
}

// Scenarios de lab avec verite terrain (Phase 5). Seed depuis data/scenarios/.
model ScenarioLab {
  id             String   @id @default(cuid())
  slug           String   @unique
  titre          String
  type           String // incident | audit | postmortem | escalade
  contexte       String // description du scenario (donnees du cas)
  objectifSy0701 String?
  coursGoogle    Int?
  veriteTerrain  String // JSON : { iocs[], chronologie[], bonnesActions[], faitsAttendus[] }
  modeleMarkdown String   @default("") // squelette de rapport propose
  creeLe         DateTime @default(now())

  rapports Rapport[]

  @@map("scenario_lab")
}

// Rapport redige par un utilisateur (Phase 5).
model Rapport {
  id            String   @id @default(cuid())
  utilisateurId String
  scenarioId    String?
  titre         String
  modele        String   @default("incident") // type de modele utilise
  contenu       String   @default("") // markdown courant
  creeLe        DateTime @default(now())
  misAJourLe    DateTime @updatedAt

  utilisateur Utilisateur         @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  scenario    ScenarioLab?        @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  versions    RapportVersion[]
  corrections CorrectionRapport[]

  @@index([utilisateurId])
  @@map("rapport")
}

model RapportVersion {
  id        String   @id @default(cuid())
  rapportId String
  contenu   String
  creeLe    DateTime @default(now())

  rapport Rapport @relation(fields: [rapportId], references: [id], onDelete: Cascade)

  @@index([rapportId])
  @@map("rapport_version")
}

model CorrectionRapport {
  id          String   @id @default(cuid())
  rapportId   String
  mode        String // coach | correcteur
  resultat    String // JSON valide (Zod) renvoye par l'IA
  noteGlobale Int? // /100 en mode correcteur
  modele      String   @default("") // modele IA utilise
  creeLe      DateTime @default(now())

  rapport Rapport @relation(fields: [rapportId], references: [id], onDelete: Cascade)

  @@index([rapportId])
  @@map("correction_rapport")
}

// Jeu de journaux synthetiques pour le SIEM (Phase 6). Genere par @secprep/loggen.
model JeuJournaux {
  id            String   @id @default(cuid())
  slug          String   @unique
  titre         String
  description   String   @default("")
  graine        String
  volume        Int      @default(0)
  veriteTerrain String   @default("{}") // JSON
  creeLe        DateTime @default(now())

  evenements Evenement[]
  enquetes   Enquete[]

  @@map("jeu_journaux")
}

model Evenement {
  id          String   @id @default(cuid())
  jeuId       String
  ts          DateTime
  source      String
  action      String
  champs      String   @default("{}") // JSON
  raw         String
  malveillant Boolean  @default(false) // verite terrain
  etiquette   String?
  origine     String   @default("simule") // simule | reel (capteur, Phase 9)

  jeu JeuJournaux @relation(fields: [jeuId], references: [id], onDelete: Cascade)

  @@index([jeuId])
  @@index([jeuId, ts])
  @@map("evenement")
}

model Enquete {
  id            String   @id @default(cuid())
  utilisateurId String
  jeuId         String
  titre         String
  verdict       String? // ex. "password_spraying"
  notes         String   @default("")
  preuves       String   @default("[]") // JSON : ids d'evenements epingles
  creeLe        DateTime @default(now())
  misAJourLe    DateTime @updatedAt

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  jeu         JeuJournaux @relation(fields: [jeuId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
  @@map("enquete")
}

// Session de bac a sable (terminal, Phase 7). Mappe un jeton a un conteneur.
model SessionSandbox {
  id            String   @id @default(cuid())
  utilisateurId String
  conteneur     String
  laboSlug      String
  creeLe        DateTime @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
  @@map("session_sandbox")
}

// Capture de paquets synthetique (Phase 8). Les paquets sont generes a la volee
// depuis la graine ; seules les metadonnees + verite terrain sont stockees.
model Capture {
  slug          String   @id
  titre         String
  description   String   @default("")
  graine        String
  veriteTerrain String   @default("{}") // JSON (inclut les exercices + reponses)
  creeLe        DateTime @default(now())

  @@map("capture")
}

model ProgressionLabo {
  id            String    @id @default(cuid())
  utilisateurId String
  laboSlug      String
  termine       Boolean   @default(false)
  termineLe     DateTime?

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, laboSlug])
  @@map("progression_labo")
}
