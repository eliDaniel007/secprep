{
  "name": "secprep",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme d'entrainement CompTIA Security+ (SY0-701) et de pratique SOC",
  "scripts": {
    "validate-bank": "pnpm --filter @secprep/bank validate-bank",
    "seed": "pnpm --filter @secprep/bank seed",
    "seed:generes": "pnpm --filter @secprep/generators seed",
    "create-user": "pnpm --filter @secprep/bank create-user",
    "db:generate": "pnpm --filter @secprep/db generate",
    "db:push": "pnpm --filter @secprep/db push",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.18",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0"
}
